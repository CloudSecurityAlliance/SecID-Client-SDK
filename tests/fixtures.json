    {
      "name": "encoding_ampersand",
      "description": "An unencoded & would end the secid parameter early (the server then sees '...#A'). All three clients must send %26, plus %40 for @ and %23 for #. request_url_contains is the whole encoded query, so the encodings must be byte-identical across languages.",
      "category": "encoding",
      "input": {
        "secid": "secid:control/cloudsecurityalliance.org/ccm@4.0#A&A-01",
        "method": "resolve"
      },
      "mock_response": {
        "http_status": 200,
        "body": {
          "secid_query": "secid:control/cloudsecurityalliance.org/ccm@4.0#A&A-01",
          "status": "found",
          "results": [
            {
              "secid": "secid:control/cloudsecurityalliance.org/ccm@4.0#A&A-01",
              "weight": 100,
              "url": "https://cloudsecurityalliance.org/research/cloud-controls-matrix"
            }
          ],
          "message": null
        }
      },
      "expected": {
        "status": "found",
        "best_url": "https://cloudsecurityalliance.org/research/cloud-controls-matrix",
        "resolution_result_count": 1,
        "request_url_contains": "secid=secid%3Acontrol%2Fcloudsecurityalliance.org%2Fccm%404.0%23A%26A-01"
      }
    },
    {
      "name": "encoding_plus",
      "description": "A literal + must be sent as %2B. Left bare, a query parser decodes it as a space.",
      "category": "encoding",
      "input": {
        "secid": "secid:reference/example.org/c++#section+1",
        "method": "resolve"
      },
      "mock_response": {
        "http_status": 200,
        "body": {
          "secid_query": "secid:reference/example.org/c++#section+1",
          "status": "found",
          "results": [
            {
              "secid": "secid:reference/example.org/c++#section+1",
              "weight": 100,
              "url": "https://example.org/c++/section-1"
            }
          ],
          "message": null
        }
      },
      "expected": {
        "status": "found",
        "best_url": "https://example.org/c++/section-1",
        "resolution_result_count": 1,
        "request_url_contains": "secid=secid%3Areference%2Fexample.org%2Fc%2B%2B%23section%2B1"
      }
    },
    {
      "name": "encoding_space",
      "description": "A space is sent as %20, never +. The server accepts both, but the reference clients must agree byte for byte (Go's url.QueryEscape emits + by default).",
      "category": "encoding",
      "input": {
        "secid": "secid:reference/example.org/doc#Annex A",
        "method": "resolve"
      },
      "mock_response": {
        "http_status": 200,
        "body": {
          "secid_query": "secid:reference/example.org/doc#Annex A",
          "status": "found",
          "results": [
            {
              "secid": "secid:reference/example.org/doc#Annex A",
              "weight": 100,
              "url": "https://example.org/doc#annex-a"
            }
          ],
          "message": null
        }
      },
      "expected": {
        "status": "found",
        "best_url": "https://example.org/doc#annex-a",
        "resolution_result_count": 1,
        "request_url_contains": "secid=secid%3Areference%2Fexample.org%2Fdoc%23Annex%20A",
