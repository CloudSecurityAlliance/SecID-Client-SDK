          "secid_query": "secid:advisory/example.org/adv#ADV-1",
          "status": "found",
          "results": [
            {
              "secid": "s",
              "weight": 100,
              "url": "javascript:alert(1)"
            },
            {
              "secid": "s",
              "weight": 99,
              "url": "data:text/html,<script>alert(1)</script>"
            },
            {
              "secid": "s",
              "weight": 98,
              "url": "file:///etc/passwd"
            },
            {
              "secid": "s",
              "weight": 97,
              "url": "//evil.example/x"
            },
            {
              "secid": "s",
              "weight": 96,
              "url": "http:evil.example"
            },
            {
              "secid": "s",
              "weight": 95,
              "url": "http:///evil.example"
            },
            {
              "secid": "s",
              "weight": 94,
              "url": "http:\\\\evil.example"
            },
            {
              "secid": "s",
              "weight": 93,
              "url": "https://"
            },
            {
              "secid": "s",
              "weight": 92,
              "url": " https://evil.example/"
            },
            {
              "secid": "s",
              "weight": 91,
              "url": "https://evil.example/\u001b[2J"
            },
            {
              "secid": "s",
              "weight": 80,
              "url": "https://ok.example/adv/ADV-1"
            },
            {
              "secid": "s",
              "weight": 70,
              "url": "HTTP://ALSO-OK.example/adv/ADV-1"
            }
          ],
          "message": null
        }
      },
